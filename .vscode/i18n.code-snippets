{
  // 슬라이스의 i18n/index.ts에서 사용. 파일 경로로 네임스페이스 상수 이름과 값을 채움
  // 예: src/pages/organization/home/i18n/index.ts
  //   → PAGES_ORGANIZATION_HOME_I18N_NAMESPACE = 'pages/organization/home'
  "Create i18n namespace file": {
    "scope": "typescript",
    "prefix": "i18nns",
    "body": [
      "import en from './en.json';",
      "",
      "import type { DeepStringify } from '\\$shared/i18n';",
      "import type ko from './ko.json';",
      "",
      "type I18nKey = DeepStringify<typeof ko>;",
      "",
      "en satisfies I18nKey;",
      "",
      "export const ${1:${RELATIVE_FILEPATH/(?:^.*src\\/)|(\\/i18n\\/index\\.ts$)|([\\/-])|([a-z0-9]+)/${2:+_}${3:/upcase}/g}_I18N_NAMESPACE} =",
      "  '${2:${RELATIVE_FILEPATH/^.*src\\/(.*)\\/i18n\\/index\\.ts$/$1/}}';",
    ],
    "description": "Create i18n namespace definition (slice i18n/index.ts)",
  },
}
