model User {
    id String @id @default(uuid(7)) @db.Uuid

    email    String @unique
    name     String
    password String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user")
}

model AuthSession {
    id String @id @default(uuid(7)) @db.Uuid

    userId String @db.Uuid

    tokenHash String @unique
    userAgent String
    ipAddress String

    expiresAt DateTime
    revokedAt DateTime?

    createAt DateTime @default(now())
    updateAt DateTime @updatedAt

    @@index([userId])
    @@index([expiresAt])
    @@map("auth_session")
}
