{
  "name": "nook",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commit": "git-cz",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "server/api:dev": "pnpm -F @server/api dev",
    "web/client:dev": "pnpm -F @web/client dev",
    "generate:packages": "pnpm -C ./packages/api-client generate && pnpm -C ./packages/i18n generate:validation",
    "clean:modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean:workspace": "pnpm -r exec rm -rf .next && rm -rf .husky/_",
    "clean": "pnpm clean:workspace && pnpm clean:modules"
  },
  "keywords": [],
  "author": "Dowon Wang",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/cz-commitlint": "^20.5.3",
    "@packages/eslint-config": "workspace:*",
    "commitizen": "^4.3.2",
    "eslint": "catalog:eslint",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:typescript5"
  }
}
